@startuml

|Hóspede|
|Sistema SERRÔ|

|Hóspede|
start
:Acessar opção "Realizar Reserva";

|Sistema SERRÔ|
:Solicitar datas de entrada, saída\ne tipo de acomodação;

|Hóspede|
:Informar os dados solicitados;

|Sistema SERRÔ|
:Verificar disponibilidade de quartos\n(considerando status e bloqueios);

if (Quartos disponíveis no período?) then (Não)
    :Exibir mensagem de erro:\n"Não há quartos disponíveis";
    stop
else (Sim)
    :Exibir opções de quartos livres\ncom valor da diária (tarifa vigente);
endif

|Hóspede|
if (Deseja continuar com a reserva?) then (Não)
    |Sistema SERRÔ|
    :Limpar dados temporários da sessão;
    :Redirecionar usuário para menu inicial;
    stop
else (Sim)
    |Hóspede|
    :Selecionar o quarto desejado;
endif

|Sistema SERRÔ|
:Apresentar resumo da reserva\n(quarto, datas, tarifa, valor total);

|Hóspede|
:Confirmar dados e informar\nnúmero de hóspedes;

|Sistema SERRÔ|
:Validar número de hóspedes\ncapacidade do quarto;

if (Número de hóspedes válido?) then (Não)
    :Exibir mensagem de erro: "Capacidade do quarto excedida";
    |Hóspede|
    :Revisar dados da reserva;
    backward :Informar número correto de hóspedes;
    |Sistema SERRÔ|
    :Revalidar capacidade;
endif

|Sistema SERRÔ|
:Calcular valor total\n(diárias x tarifa vigente);

|Hóspede|
:Confirmar e enviar reserva;

|Sistema SERRÔ|
:Registrar reserva no banco\ncom status "CONFIRMADA";
:Gerar código único da reserva;

fork
    :Enviar confirmação por e-mail\ncom dados da reserva;
fork again
    :Atualizar status do quarto\npara "OCUPADO";
fork again
    :Abrir Conta de Hospedagem\n(vinculada à reserva);
end merge

stop
@enduml
