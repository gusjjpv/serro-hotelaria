@startuml

|Usuário|
start
:Acessar opção "Realizar Reserva";

|Sistema SERRÔ|
:Solicitar datas de entrada, saída\ne quantidade de hóspedes;

|Usuário|
:Informar os dados solicitados;

|Sistema SERRÔ|
:Consultar disponibilidade de Quarto\n(consultarDisponibilidade);
:Verificar bloqueios de Manutenção\n(estaBloqueado);

if (Quartos disponíveis e liberados?) then (Sim)
    :Obter tarifa vigente\n(obterTarifaVigente);
    :Calcular valor total da estadia;
    :Exibir opções de quartos e resumo de valores;
else (Não)
    :Exibir mensagem:\n"Não há quartos disponíveis para o período";
    stop
endif

|Usuário|
if (Confirmar intenção de reserva?) then (Sim)
    :Confirmar dados cadastrais;
    :Clicar em "Finalizar Reserva";
else (Não)
    |Sistema SERRÔ|
    :Limpar dados temporários da sessão;
    :Redirecionar para tela inicial;
    stop
endif

|Sistema SERRÔ|
:Registrar Reserva no banco\ncom status "CONFIRMADA";

fork
    :Vincular Quarto à Reserva;
fork again
    :Instanciar nova Conta de Hospedagem\n(abrir);
fork again
    :Enviar voucher de confirmação\npor e-mail;
end fork

:Exibir tela de sucesso com\nCódigo da Reserva;

stop
@enduml