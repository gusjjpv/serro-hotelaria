@startuml
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam componentStyle rectangle

skinparam database {
    BackgroundColor White
    BorderColor #4A4A4A
}

skinparam interface {
    BackgroundColor #FFF8E1
    BorderColor #F9A825
}

package "Client-Side (Front-end)" #EEF2FF {
    component "Aplicação React (SPA)\n[Navegador Web]" as react {
        port " " as p_react
    }
}

package "Server-Side (Back-end)" #E8F5E9 {
    interface "API REST (JSON)" as api
    
    component "Servidor Django" as django {
        component "Controllers (Views/ViewSets)" as views
        component "Models (ORM)" as models
        
        views -> models : consulta/atualiza
    }
}

database "db.sqlite3\n[Banco de Dados Relacional]" as db

p_react ..> api : Requisições HTTP\n(GET, POST, PUT, DELETE)
api - django
models ..> db : Conexão\n(Django ORM)

@enduml