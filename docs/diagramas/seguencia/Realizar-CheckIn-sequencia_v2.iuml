@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam maxmessagesize 150

skinparam sequence {
    LifeLineBorderColor #4A4A4A
    LifeLineBackgroundColor #F9F9F9
    GroupBorderColor #000000
    GroupHeaderFontColor Black
    GroupHeaderBackgroundColor #1565C0
    ActorBorderColor #4A4A4A
    ParticipantBorderColor #4A4A4A
    ParticipantBackgroundColor White
}

actor "Hóspede" as hospede
boundary "view : TelaCheckIn" as tela
control "ctrl : ReservaCheckInView" as ctrl
control "serializer : ReservaCheckInSerializer" as serializer
entity "reserva : Reserva" as reserva
entity "quarto : Quarto" as quarto
database "db : BancoDeDados" as db

hospede -> tela : P.01 acessarOpcaoCheckIn()
activate tela

tela -> ctrl : P.02 buscarReserva(reserva.id)
activate ctrl

ctrl -> serializer : P.03 validar(reserva.id)
activate serializer

serializer -> db : P.04 consultarReserva(reserva.id)
activate db
db -->> serializer : P.05 dadosReservaRetornados
deactivate db

alt E01: Reserva não encontrada
    serializer -->> ctrl : E.01 erro("Reserva não encontrada")
    ctrl -->> tela : E.02 erro(404)
    tela -->> hospede : E.03 exibirMensagemErro()

else P01: Reserva encontrada
    serializer -> serializer : P.06 verificarStatus(CONFIRMADA)

    alt E02: Status inválido
        serializer -->> ctrl : E.04 erro("Reserva não está confirmada")
        ctrl -->> tela : E.05 erro(400)
        tela -->> hospede : E.06 exibirMensagemErro()

    else P02: Status CONFIRMADA
        serializer -> serializer : P.07 validarHorario(dataEntrada)

        alt E03: Fora do horário
            serializer -->> ctrl : E.07 erro("Horário ainda não liberado")
            ctrl -->> tela : E.08 erro(400)
            tela -->> hospede : E.09 exibirMensagemErro()

        else P03: Horário liberado
            serializer -> serializer : P.08 verificarQuartoAtribuido()

            alt E04: Quarto não atribuído
                serializer -->> ctrl : E.10 erro("Nenhum quarto atribuído")
                ctrl -->> tela : E.11 erro(400)
                tela -->> hospede : E.12 exibirMensagemErro()

            else P05: Quarto atribuído
                ctrl -> reserva : P.09 getDetalhes()
                activate reserva
                reserva -->> ctrl : P.10 detalhesRetornados
                deactivate reserva

                ctrl -->> tela : P.11 exibirDetalhesReserva()

                hospede -> tela : P.12 confirmarCheckIn()
                tela -> ctrl : P.13 processarCheckIn(reserva.id)

                ctrl -> db : P.14 salvarCheckIn()
                activate db

                db -> reserva : P.15 setStatus(CHECK_IN)
                activate reserva
                reserva -->> db : P.16 statusAtualizado
                deactivate reserva

                db -> quarto : P.17 setStatus(OCUPADO)
                activate quarto
                quarto -->> db : P.18 statusAtualizado
                deactivate quarto

                db -->> ctrl : P.19 checkInSalvo
                deactivate db

                create entity "conta : Conta Hospedagem" as conta
                ctrl -> conta : P.20 <<create>> (new ContaHospedagem)
                activate conta
                conta -->> ctrl : P.21 contaCriada
                deactivate conta

                ctrl -> db : P.22 inserirNovaConta(conta.dados)
                activate db
                db -->> ctrl : P.23 idContaGerado
                deactivate db

                ctrl -> ctrl : P.24 enviar_email_checkin_reserva(reserva)

                ctrl -->> tela : P.25 confirmacaoSucesso
                deactivate ctrl

                tela -->> hospede : P.26 exibirMensagemSucesso()
            end
        end
    end
end

deactivate tela

@enduml
