@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam maxmessagesize 150

skinparam sequence {
    LifeLineBorderColor #4A4A4A
    LifeLineBackgroundColor #F9F9F9
    GroupBorderColor #000000
    GroupHeaderFontColor #000000
    GroupHeaderBackgroundColor #1565C0
    ActorBorderColor #4A4A4A
    ParticipantBorderColor #4A4A4A
    ParticipantBackgroundColor White
}

actor "Hóspede" as hospede
boundary "view : TelaCheckIn" as tela
control "ctrl : CheckInController" as ctrl
entity "reserva : Reserva" as reserva
entity "quarto : Quarto" as quarto
database "db : BancoDeDados" as db

hospede -> tela : P.01 acessarOpcaoCheckIn()
activate tela

tela -> ctrl : P.02 buscarReservaValida(hospede.id, dataAtual)
activate ctrl

ctrl -> db : P.03 consultarReserva(hospede.id, dataAtual)
activate db
db -->> ctrl : P.04 dadosReservaRetornados
deactivate db

alt E01: Fora do Horário Padrão
    ctrl -> ctrl : E.01 validarHorarioLiberacao()
    ctrl -->> tela : E.02 erro("Horário ainda não liberado")
    tela -->> hospede : E.03 exibirMensagemErro()

else P01: Horário Liberado
    ctrl -> reserva : P.05 getDetalhes()
    activate reserva
    reserva -->> ctrl : P.06 detalhesRetornados
    deactivate reserva
    
    ctrl -->> tela : P.07 exibirDetalhesReserva()
    
    hospede -> tela : P.08 selecionarReserva(reserva.id)
    tela -> ctrl : P.09 buscarDadosCadastro(hospede.id)

    ctrl -> db : P.10 consultarDadosHospede(hospede.id)
    activate db
    db -->> ctrl : P.11 dadosCadastrais
    deactivate db

    ctrl -->> tela : P.12 dadosCadastrais
    tela -->> hospede : P.13 exibirFormularioPreenchido()

    opt A01: Atualizar Dados Cadastrais
        hospede -> tela : A.01 clicarEditarDados()
        tela -->> hospede : A.02 habilitarCamposEdicao()
        hospede -> tela : A.03 inserirNovosDados(dados)
        tela -> ctrl : A.04 validarEAtualizarCadastro(dados)

        ctrl -> db : A.05 atualizarDadosHospede(dados)
        activate db
        db -->> ctrl : A.06 confirmacaoAtualizacao
        deactivate db

        ctrl -->> tela : A.07 cadastroAtualizado
        tela -->> hospede : A.08 atualizarTelaConfirmacao()
    end

    hospede -> tela : P.14 confirmarCheckIn()
    tela -> ctrl : P.15 processarCheckIn(reserva.id)

    ctrl -> reserva : P.16 realizarCheckIn()
    activate reserva
    reserva -->> ctrl : P.17 statusAtualizado
    deactivate reserva

    ctrl -> db : P.18 salvarStatusReserva(reserva.id, CHECK_IN)
    activate db
    db -->> ctrl : P.19 statusReservaAtualizado
    deactivate db

    ctrl -> quarto : P.20 atualizarStatus(OCUPADO)
    activate quarto
    quarto -->> ctrl : P.21 statusAtualizado
    deactivate quarto

    ctrl -> db : P.22 salvarStatusQuarto(quarto.numero, OCUPADO)
    activate db
    db -->> ctrl : P.23 statusQuartoAtualizado
    deactivate db

    create entity "conta : Conta Hospedagem" as conta
    ctrl -> conta : P.24 <<create>> (new ContaHospedagem)
    activate conta
    conta -->> ctrl : P.25 contaAberta
    deactivate conta

    ctrl -> db : P.26 inserirNovaConta(conta.dados)
    activate db
    db -->> ctrl : P.27 idContaGerado
    deactivate db

    ctrl -->> tela : P.28 confirmacaoSucesso
    deactivate ctrl

    tela -->> hospede : P.29 exibirMensagemEInstrucoes()
    deactivate tela
end

@enduml